{
  "name": "dsh-pdf-3d-pipeline",
  "version": "0.2.0",
  "description": "Turn a 2D drawing PDF into a SolidWorks part - callouts, DWG/DXF, banded extrude, SLDPRT/STEP - with gates that refuse to hand over a model whose counterbores are on the wrong face. dsh bundle + skill for Windows.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1123443202/dsh-pdf-3d-pipeline.git"
  },
  "homepage": "https://github.com/1123443202/dsh-pdf-3d-pipeline#readme",
  "bugs": {
    "url": "https://github.com/1123443202/dsh-pdf-3d-pipeline/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "skill",
    "cad",
    "solidworks",
    "autocad",
    "pdf",
    "dwg",
    "dxf",
    "windows"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "pdf3d": "bin/pdf3d.mjs"
  },
  "files": [
    "SKILL.md",
    "AGENTS.md",
    "QUICKSTART.md",
    "README.md",
    "MARKET.md",
    "run.ps1",
    "install.ps1",
    "cordis.patch.yml",
    "lib/",
    "bin/",
    "reference/",
    "scripts/",
    "!**/__pycache__",
    "!**/*.pyc",
    "!**/*.pyo"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32"
  ]
}
